# Copy to .env before first start: cp .env.example .env
# Local dev only — do not use these values in production or on cluster.

# Keep Langfuse separate from the prototype dev server, which commonly uses :3000.
LANGFUSE_LOCAL_PORT=3100
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me-use-openssl-rand-hex-32

SALT=change-me-use-openssl-rand-hex-16
ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

REDIS_AUTH=myredissecret
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# Pre-seed org/project so SDK keys are known before UI login
LANGFUSE_INIT_ORG_ID=uxd-local-org
LANGFUSE_INIT_ORG_NAME=UXD Local
LANGFUSE_INIT_PROJECT_ID=uxd-eval-local
LANGFUSE_INIT_PROJECT_NAME=uxd-prototype-evaluate
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-uxd-eval
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-uxd-eval-secret
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=UXD Admin
LANGFUSE_INIT_USER_PASSWORD=langfuse-local-dev

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
