{
  "schema_version": 1,
  "artifacts": {
    "user-stories.json": {
      "type": "object",
      "required": ["stories"],
      "properties": {
        "prototype_id": {"type": "string"},
        "stories": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1}}
      }
    },
    "journeys.json": {
      "type": "object",
      "required": ["prototype_id", "extracted_at", "journeys"],
      "properties": {
        "prototype_id": {"type": "string"},
        "extracted_at": {"type": "string"},
        "journeys": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "title", "steps"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "persona": {"type": "string"},
              "source": {"type": "string", "enum": ["jira", "inferred", "user"]},
              "ac_ids": {"type": "array", "items": {"type": "string"}},
              "steps": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["id", "name", "route"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "name": {"type": "string", "minLength": 1},
                    "route": {"type": "string", "minLength": 1},
                    "export": {"type": "boolean"},
                    "actions": {"type": "array", "items": {"type": "object"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "scenarios.json": {
      "type": "object",
      "required": ["prototype_id", "extracted_at", "pages"],
      "properties": {
        "prototype_id": {"type": "string"},
        "extracted_at": {"type": "string"},
        "pages": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["route", "scenarios"],
            "properties": {
              "route": {"type": "string", "minLength": 1},
              "screen": {"type": "string"},
              "scenarios": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["id", "name"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                    "name": {"type": "string", "minLength": 1},
                    "description": {"type": "string"},
                    "default": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
