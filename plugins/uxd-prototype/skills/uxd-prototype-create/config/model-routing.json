{
  "provider": "openai",
  "default_model": "gpt-6-sol",
  "judge_model": "gpt-6-luna",
  "cap_usd": 15.0,
  "phases": {
    "create-plan": {
      "model": "gpt-6-sol",
      "reasoning_effort": "medium",
      "max_turns": null,
      "max_prompt_bytes": 65536,
      "max_output_tokens_per_turn": 5000,
      "max_tool_calls": 48,
      "max_run_seconds": 3600,
      "max_output_files": 12,
      "max_output_bytes": 1500000,
      "input_tokens_bound": 500000,
      "output_tokens_bound": 20000,
      "expected_outputs": ["user-stories.json", "journeys.json", "scenarios.json"]
    },
    "create-generate": {
      "model": "gpt-6-sol",
      "reasoning_effort": "high",
      "max_turns": null,
      "max_prompt_bytes": 65536,
      "max_output_tokens_per_turn": 8000,
      "max_tool_calls": 120,
      "max_run_seconds": 5400,
      "max_output_files": 64,
      "max_output_bytes": 8000000,
      "input_tokens_bound": 1600000,
      "output_tokens_bound": 64000,
      "expected_outputs": ["metadata.json", "prototype-summary.yaml", "consistency-report.json"]
    },
    "create-refine": {
      "model": "gpt-6-sol",
      "reasoning_effort": "medium",
      "max_turns": null,
      "max_prompt_bytes": 65536,
      "max_output_tokens_per_turn": 6000,
      "max_tool_calls": 64,
      "max_run_seconds": 3600,
      "max_output_files": 40,
      "max_output_bytes": 4000000,
      "input_tokens_bound": 500000,
      "output_tokens_bound": 24000,
      "expected_outputs": ["changeset.md", "consistency-report.json", "refine-validation.json"]
    }
  }
}
